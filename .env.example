# Advanced Corrective RAG Engine - Environment Configuration

# 1. Google Gemini API Key (Mandatory for embeddings, generation, grading, vision OCR)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Tavily Search API Key (Recommended for live web search fallback)
# Get from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Qdrant Cloud Vector Database (Optional - defaults to local in-memory store if unset)
# Get from: https://cloud.qdrant.io/
QDRANT_URL=your_qdrant_cloud_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# 4. LangSmith / LangChain Tracing (Optional)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
